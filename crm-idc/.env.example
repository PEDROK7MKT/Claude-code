# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Apenas no servidor — NUNCA exponha no navegador
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Segredo do webhook /api/webhook/lead (envie no header "Authorization: Bearer <valor>" ou "x-webhook-secret")
# Obrigatório para o webhook; gere com: openssl rand -hex 32 (vazio = webhook desligado, responde 503)
WEBHOOK_SECRET=
# Origens autorizadas a chamar o webhook direto do navegador (CORS), separadas por vírgula
WEBHOOK_ALLOWED_ORIGINS=https://institutodeciocarrilho.com.br,https://www.institutodeciocarrilho.com.br
