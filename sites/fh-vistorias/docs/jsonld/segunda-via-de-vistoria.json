      "mainEntity": [
        {
          "@type": "Question",
          "name": "Como pedir a segunda via da vistoria na FH?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Chame no WhatsApp (77) 99122-8535 com a placa do veículo e o nome de quem fez a vistoria. A equipe informa o valor e como retirar a nova via do laudo."
          }
        },
        {
          "@type": "Question",
          "name": "Perdi o documento ou vou colocar placa Mercosul. Preciso de vistoria?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pode precisar. Segundo orientação publicada pela FH Vistorias, a vistoria costuma ser exigida em casos como segunda via de documento, troca para placa Mercosul, placa perdida ou danificada, troca de motor e mudança de característica. Como cada caso segue regras próprias do DETRAN-BA, confirme o seu pelo WhatsApp."
          }
        },
        {
          "@type": "Question",
          "name": "Qual o horário de funcionamento da FH Vistorias?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Segunda a sexta, das 7h30 às 12h10 e das 14h às 17h30. Sábados, domingos e feriados: consulte pelo WhatsApp."
          }
        }
      ]
